# Match `target/` at any depth — the root crate and the example sub-crate
# each have their own build directory.
target/
**/*.rs.bk

# Local cross-compile linker/rustflags config — not repo content.
.cargo/

# Environment files (must never be committed).
.env
.env.*

# Editor / OS scratch.
.idea/
.vscode/
*.swp
.DS_Store

# Coverage artifacts.
*.profraw
